{
  "name": "akar-monorepo",
  "type": "module",
  "version": "2.0.23",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "license": "MIT",
  "repository": "vinicunca/akar",
  "scripts": {
    "story:dev": "pnpm --filter histoire story:dev --open",
    "build": "pnpm run --filter akar build && pnpm run --filter plugins build",
    "build-only": "pnpm run -r build-only",
    "docs:install": "pnpm --filter docs install",
    "docs:dev": "pnpm --filter docs docs:dev",
    "docs:build": "pnpm --filter docs docs:build",
    "docs:gen": "pnpm --filter docs docs:gen",
    "docs:contributors": "pnpm --filter docs docs:contributors",
    "docs:meta": "node scripts/docs-meta.mjs",
    "prepare": "pnpm simple-git-hooks",
    "test": "pnpm --filter akar test",
    "test-update": "pnpm --filter akar test-update",
    "test:browser": "pnpm --filter akar test:browser",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp package.json packages/*/package.json docs/package.json",
    "pub:release": "cd packages/core && pnpm pub:release"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vinicunca/eslint-config": "^6.1.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vue-component-meta": "3.3.11"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
