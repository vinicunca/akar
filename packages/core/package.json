{
  "name": "akar",
  "type": "module",
  "version": "2.2.0",
  "description": "Vue UI primitives components",
  "author": "Vinicunca Contributors (https://github.com/vinicunca)",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/praburangki"
  },
  "homepage": "https://github.com/vinicunca/akar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicunca/akar.git"
  },
  "bugs": {
    "url": "https://github.com/vinicunca/akar/issues"
  },
  "keywords": [
    "ui",
    "vue",
    "accessibility",
    "headless",
    "nuxt",
    "primitives",
    "components",
    "radix",
    "unstyled"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    },
    "./constant": {
      "import": "./dist/constant.js",
      "require": "./dist/constant.cjs"
    },
    "./date": {
      "import": "./dist/date.js",
      "require": "./dist/date.cjs"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./namespaced": {
      "import": "./dist/namespaced/index.mjs",
      "require": "./dist/namespaced/index.cjs"
    },
    "./nuxt": {
      "import": "./dist/nuxt/index.mjs",
      "require": "./dist/nuxt/index.cjs"
    },
    "./resolver": {
      "import": "./dist/resolver/index.mjs",
      "require": "./dist/resolver/index.cjs"
    },
    "./vapor": {
      "types": "./dist/vapor/index.d.ts",
      "node": "./dist/vapor/ssr.cjs",
      "import": "./dist/vapor/index.js",
      "require": "./dist/vapor/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "internal": ["./dist/internal.d.ts"],
      "constant": ["./dist/constant.d.ts"],
      "date": ["./dist/date.d.ts"],
      "agent": ["./dist/agent.d.ts"],
      "namespaced": ["./dist/namespaced/index.d.cts"],
      "nuxt": ["./dist/nuxt/index.d.cts"],
      "resolver": ["./dist/resolver/index.d.cts"],
      "vapor": ["./dist/vapor/index.d.ts"]
    }
  },
  "files": [
    "src",
    "dist",
    "NOTICE",
    "!src/**/*.story.vue",
    "!src/**/*.test.*",
    "!src/**/*.test-d.ts",
    "!src/**/__test__",
    "!src/test",
    "!src/**/_*.vue",
    "!src/**/__snapshots__",
    "!src/**/stories",
    "!src/**/story",
    "!src/agent/test"
  ],
  "scripts": {
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "tsdown && vite build -c vapor/vite.config.mjs && tsx scripts/postbuild.ts",
    "watch": "tsdown --watch",
    "type-check": "vue-tsc -p tsconfig.check.json --noEmit && vue-tsc -p tsconfig.vapor.json --noEmit",
    "test:run": "vitest run",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test-update": "vitest -u",
    "pub:release": "npm publish --access public --provenance --tag \"$(node scripts/npm-dist-tag.mjs)\"",
    "size": "size-limit",
    "package:check": "node package-check/run.mjs",
    "test:vapor": "vitest run --config vitest.vapor.config.ts",
    "test:vapor:node": "node --test vapor/tests/plugins.node.test.mjs",
    "test:vapor:dist": "node vapor/tests/dist-node.mjs && vitest run --config vitest.vapor.config.ts --mode dist",
    "vapor:expectations": "vite build -c vapor/vite.config.mjs --mode update-expectations"
  },
  "peerDependencies": {
    "vue": ">= 3.5.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.9",
    "@tanstack/vue-virtual": "3.12.0",
    "@vinicunca/perkakas": "1.19.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "aria-hidden": "^1.2.4",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.4",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vue/server-renderer": "^3.5.46",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "size-limit": "^14.3.0",
    "tsdown": "^0.12.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "0.1.0",
    "vitest-canvas-mock": "^1.2.0",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14",
    "vue-vapor": "npm:vue@3.6.0-rc.16"
  }
}
